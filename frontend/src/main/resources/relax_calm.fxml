<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.zenith.frontend.RelaxCalmController"
      prefWidth="1280" prefHeight="720"
      style="-fx-background-color: linear-gradient(to bottom right, #f0f4f8, #e1e9f0);">

    <VBox prefWidth="240" prefHeight="720" alignment="TOP_CENTER"
          style="-fx-background-color: #1a3a4a; -fx-padding: 32 0 32 0;">
        <ImageView fitWidth="70" fitHeight="70" preserveRatio="true">
            <image><Image url="@/images/Zenith_Logo.png"/></image>
        </ImageView>
        <Region prefHeight="40"/>
        <HBox fx:id="navHome" alignment="CENTER_LEFT" onMouseClicked="#handleHome" prefHeight="54" style="-fx-padding: 0 0 0 32; -fx-cursor: hand;">
            <Label text="⌂" style="-fx-font-size: 22px; -fx-text-fill: #b0c8d4;"/>
            <Label text="  Home" style="-fx-font-size: 15px; -fx-text-fill: #b0c8d4;"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" prefHeight="54" style="-fx-background-color: #7dd8f0; -fx-padding: 0 0 0 32;">
            <Label text="🧘" style="-fx-font-size: 20px; -fx-text-fill: #1a3a4a;"/>
            <Label text="  Relax" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
        </HBox>
        <HBox fx:id="navGames" alignment="CENTER_LEFT" onMouseClicked="#handleCalmingGames" prefHeight="54" style="-fx-padding: 0 0 0 32; -fx-cursor: hand;">
            <Label text="🎮" style="-fx-font-size: 20px; -fx-text-fill: #b0c8d4;"/>
            <Label text="  Games" style="-fx-font-size: 15px; -fx-text-fill: #b0c8d4;"/>
        </HBox>
        <HBox fx:id="navStats" alignment="CENTER_LEFT" onMouseClicked="#handleStatistics" prefHeight="54" style="-fx-padding: 0 0 0 32; -fx-cursor: hand;">
            <Label text="📊" style="-fx-font-size: 20px; -fx-text-fill: #b0c8d4;"/>
            <Label text="  Statistics" style="-fx-font-size: 15px; -fx-text-fill: #b0c8d4;"/>
        </HBox>
        <Region VBox.vgrow="ALWAYS"/>
        <HBox fx:id="navLogout" alignment="CENTER_LEFT" onMouseClicked="#handleLogout" prefHeight="54" style="-fx-padding: 0 0 0 32; -fx-cursor: hand;">
            <Label text="🚪" style="-fx-font-size: 20px; -fx-text-fill: #e88;"/>
            <Label text="  Logout" style="-fx-font-size: 15px; -fx-text-fill: #e88;"/>
        </HBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" alignment="TOP_CENTER" spacing="0">
        <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>

        <VBox alignment="CENTER" spacing="10">
            <Label text="Relax &amp; Calm" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
            <Label text="Breathe in peace, breathe out stress. Select a soundscape to begin."
                   style="-fx-font-size: 17px; -fx-text-fill: #5a7a8a;"/>
        </VBox>

        <Region prefHeight="60"/>

        <HBox alignment="CENTER" spacing="40">
            <VBox fx:id="cardRain" prefWidth="280" prefHeight="340" alignment="CENTER" spacing="25"
                  style="-fx-background-color: white; -fx-background-radius: 30; -fx-border-color: #d1d5db; -fx-border-width: 0.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                <StackPane prefWidth="100" prefHeight="100" style="-fx-background-color: #f0f9ff; -fx-background-radius: 50;">
                    <Label text="🌧️" style="-fx-font-size: 50px;"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Tropical Rain" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
                    <Label text="Nature • Calming" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-font-style: italic;"/>
                </VBox>
                <Button fx:id="btnRain" text="▶ Play" onAction="#handlePlayRain"
                        style="-fx-background-color: #1a3a4a; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 25; -fx-padding: 14 32; -fx-cursor: hand;"/>
            </VBox>

            <VBox fx:id="cardOcean" prefWidth="280" prefHeight="340" alignment="CENTER" spacing="25"
                  style="-fx-background-color: white; -fx-background-radius: 30; -fx-border-color: #d1d5db; -fx-border-width: 0.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                <StackPane prefWidth="100" prefHeight="100" style="-fx-background-color: #eff6ff; -fx-background-radius: 50;">
                    <Label text="🌊" style="-fx-font-size: 50px;"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Ocean Waves" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
                    <Label text="Ocean • Deep Focus" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-font-style: italic;"/>
                </VBox>
                <Button fx:id="btnOcean" text="▶ Play" onAction="#handlePlayOcean"
                        style="-fx-background-color: #1a3a4a; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 25; -fx-padding: 14 32; -fx-cursor: hand;"/>
            </VBox>

            <VBox fx:id="cardForest" prefWidth="280" prefHeight="340" alignment="CENTER" spacing="25"
                  style="-fx-background-color: white; -fx-background-radius: 30; -fx-border-color: #d1d5db; -fx-border-width: 0.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                <StackPane prefWidth="100" prefHeight="100" style="-fx-background-color: #f0fdf4; -fx-background-radius: 50;">
                    <Label text="🌲" style="-fx-font-size: 50px;"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Deep Forest" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
                    <Label text="Forest • Grounding" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-font-style: italic;"/>
                </VBox>
                <Button fx:id="btnForest" text="▶ Play" onAction="#handlePlayForest"
                        style="-fx-background-color: #1a3a4a; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 25; -fx-padding: 14 32; -fx-cursor: hand;"/>
            </VBox>
        </HBox>
    </VBox>
</HBox>