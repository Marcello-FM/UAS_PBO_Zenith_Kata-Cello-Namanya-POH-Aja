<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.zenith.frontend.QuestionnaireController"
      prefWidth="1280" prefHeight="720"
      style="-fx-background-color: #1a3a4a;">

    <StackPane prefWidth="480"
               style="-fx-background-color: #142e3e;">

        <ImageView fitWidth="320" fitHeight="320"
                   preserveRatio="true" opacity="0.10">
            <image><Image url="@/images/Zenith_Logo.png"/></image>
        </ImageView>

        <VBox alignment="CENTER" spacing="20">
            <StackPane prefWidth="120" prefHeight="120">
                <Circle radius="55"
                        fill="transparent"
                        stroke="#f5c842"
                        strokeWidth="4"/>
                <Label text="?"
                       style="-fx-font-size: 64px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #f5c842;"/>
            </StackPane>

            <Label text="Stress Assessment"
                   style="-fx-text-fill: white;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;"/>

            <Label text="Answer a few quick questions to understand&#10;your current stress level and get&#10;personalized recommendations."
                   wrapText="true"
                   textAlignment="CENTER"
                   style="-fx-text-fill: #b0c8d4;
                          -fx-font-size: 14px;
                          -fx-alignment: center;"
                   maxWidth="360"/>
        </VBox>
    </StackPane>

    <VBox HBox.hgrow="ALWAYS"
          alignment="CENTER"
          style="-fx-padding: 60 80 60 80; -fx-background-color: #1a3a4a;"
          spacing="0">

        <HBox alignment="CENTER_LEFT">
            <Button fx:id="backButton" text="&#8249;  Back"
                    onAction="#handleBack"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #b0c8d4;
                           -fx-font-size: 18px;
                           -fx-cursor: hand;
                           -fx-border-color: transparent;
                           -fx-padding: 4 0 4 0;"/>
        </HBox>

        <Region prefHeight="32"/>

        <VBox spacing="16"
              style="-fx-background-color: white;
                     -fx-background-radius: 20;
                     -fx-padding: 32 36 32 36;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 16, 0, 0, 4);">

            <Label text="What to expect:"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1a3a4a;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="4" fill="#7dd8f0"/>
                <Label text="5 simple questions about your recent wellbeing"
                       style="-fx-font-size: 14px; -fx-text-fill: #2a5a6a;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="4" fill="#7dd8f0"/>
                <Label text="It takes about 2 minutes to complete"
                       style="-fx-font-size: 14px; -fx-text-fill: #2a5a6a;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="4" fill="#7dd8f0"/>
                <Label text="Personalized insights and recommendations"
                       style="-fx-font-size: 14px; -fx-text-fill: #2a5a6a;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="4" fill="#7dd8f0"/>
                <Label text="Track your progress overtime"
                       style="-fx-font-size: 14px; -fx-text-fill: #2a5a6a;"/>
            </HBox>
        </VBox>

        <Region prefHeight="48"/>

        <Button fx:id="startButton" text="Start Assessment"
                prefWidth="400" prefHeight="54"
                onAction="#handleStart"
                style="-fx-background-color: #f5c842;
                       -fx-text-fill: #1a3a4a;
                       -fx-font-size: 17px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 28;
                       -fx-cursor: hand;
                       -fx-border-color: transparent;"/>
    </VBox>
</HBox>
