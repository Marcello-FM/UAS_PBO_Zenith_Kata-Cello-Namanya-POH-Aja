<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@styles/dashboard.css" styleClass="root-pane" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.zenith.frontend.QuestionnaireController">
    <children>
        <VBox layoutX="240.0" layoutY="60.0" prefHeight="600.0" prefWidth="800.0" spacing="25.0" styleClass="center-box">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <BorderPane prefWidth="720.0">
                    <left>
                        <Label text="Kuisioner Mental" textFill="#7dd8f0" BorderPane.alignment="CENTER">
                            <font>
                                <Font name="System Bold" size="26.0" />
                            </font>
                        </Label>
                    </left>
                    <right>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0" BorderPane.alignment="CENTER">
                            <children>
                                <Label fx:id="progressLabel" text="1 / 5" textFill="#888888">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <ProgressBar fx:id="progressBar" prefHeight="10.0" prefWidth="150.0" progress="0.2" style="-fx-accent: #7dd8f0; -fx-control-inner-background: #1f3b4d;" />
                            </children>
                        </VBox>
                    </right>
                </BorderPane>

                <Region prefHeight="2.0" style="-fx-background-color: #1f3b4d; -fx-background-radius: 2;" />

                <VBox alignment="CENTER" prefHeight="160.0" style="-fx-background-color: #1f3b4d; -fx-background-radius: 15; -fx-border-color: #2a4b61; -fx-border-radius: 15; -fx-border-width: 2;">
                    <padding>
                        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
                    </padding>
                    <children>
                        <Label fx:id="questionLabel" text="Memuat pertanyaan..." textFill="WHITE" wrapText="true" textAlignment="CENTER">
                            <font>
                                <Font size="20.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <GridPane alignment="CENTER" hgap="20.0" vgap="20.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>
                    <children>
                        <Button fx:id="option1Button" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleOption1" prefHeight="65.0" styleClass="menu-button" text="Tidak Pernah" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Button fx:id="option2Button" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleOption2" prefHeight="65.0" styleClass="menu-button" text="Kadang-kadang" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Button fx:id="option3Button" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleOption3" prefHeight="65.0" styleClass="menu-button" text="Sering" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Button fx:id="option4Button" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleOption4" prefHeight="65.0" styleClass="menu-button" text="Hampir Selalu" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>

                <Region VBox.vgrow="ALWAYS" />

                <VBox alignment="CENTER">
                    <children>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="40.0" prefWidth="250.0" styleClass="logout-button" text="Batalkan &amp; Kembali" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>