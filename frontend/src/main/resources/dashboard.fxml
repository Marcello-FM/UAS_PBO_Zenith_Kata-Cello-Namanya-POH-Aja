<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@styles/dashboard.css" styleClass="root-pane" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.zenith.frontend.DashboardController">
    <children>
        <VBox alignment="CENTER" layoutX="390.0" layoutY="110.0" prefHeight="500.0" prefWidth="500.0" spacing="25.0" styleClass="center-box">
            <children>
                <Label fx:id="welcomeLabel" text="Zenith Dashboard" textFill="#7dd8f0">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </Label>
                <Button fx:id="relaxationButton" mnemonicParsing="false" onAction="#handleRelaxation" prefHeight="50.0" prefWidth="350.0" styleClass="menu-button" text="Game Relaksasi" />
                <Button fx:id="questionnaireButton" mnemonicParsing="false" onAction="#handleQuestionnaire" prefHeight="50.0" prefWidth="350.0" styleClass="menu-button" text="Kuisioner Mental" />
                <Button fx:id="historyButton" mnemonicParsing="false" onAction="#handleHistory" prefHeight="50.0" prefWidth="350.0" styleClass="menu-button" text="Progress &amp; Riwayat" />
                <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" prefHeight="50.0" prefWidth="350.0" styleClass="logout-button" text="Logout">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </Button>
            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>