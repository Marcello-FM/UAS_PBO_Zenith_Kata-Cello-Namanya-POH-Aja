<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.zenith.frontend.DashboardController"
      prefWidth="1280" prefHeight="720"
      stylesheets="@/styles/dashboard.css"
      style="-fx-background-color: #f4f7f9;">

    <VBox prefWidth="220" prefHeight="720"
          alignment="TOP_CENTER"
          style="-fx-background-color: #1a3a4a; -fx-padding: 28 0 28 0;">

        <ImageView fitWidth="64" fitHeight="64" preserveRatio="true">
            <image><Image url="@/images/Zenith_Logo.png"/></image>
            <effect><javafx.scene.effect.ColorAdjust brightness="1.0" saturation="-1.0"/></effect>
        </ImageView>

        <Region prefHeight="32"/>

        <HBox fx:id="navHome" alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              style="-fx-background-color: #7dd8f0; -fx-padding: 0 0 0 28; -fx-cursor: hand;">
            <Label text="⌂" style="-fx-font-size: 20px; -fx-text-fill: #1a3a4a;"/>
            <Label text="  Home" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
        </HBox>

        <Region prefHeight="4"/>

        <HBox fx:id="navRelax" alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              onMouseClicked="#handleRelax" styleClass="sidebar-hover" style="-fx-padding: 0 0 0 28;">
            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                <image><Image url="@/images/mdi_meditation.png"/></image>
                <effect><javafx.scene.effect.ColorAdjust brightness="1.0" saturation="-1.0"/></effect>
            </ImageView>
            <Label text="  Relax" style="-fx-font-size: 14px; -fx-text-fill: #b0c8d4;"/>
        </HBox>

        <Region prefHeight="4"/>

        <HBox fx:id="navGames" alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              onMouseClicked="#handleCalmingGames" styleClass="sidebar-hover" style="-fx-padding: 0 0 0 28;">
            <Label text="🎮" style="-fx-font-size: 18px; -fx-text-fill: #b0c8d4;"/>
            <Label text="  Games" style="-fx-font-size: 14px; -fx-text-fill: #b0c8d4;"/>
        </HBox>

        <Region prefHeight="4"/>

        <HBox fx:id="navStats" alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              onMouseClicked="#handleMyProgress" styleClass="sidebar-hover" style="-fx-padding: 0 0 0 28;">
            <Label text="📊" style="-fx-font-size: 18px; -fx-text-fill: #b0c8d4;"/>
            <Label text="  Statistics" style="-fx-font-size: 14px; -fx-text-fill: #b0c8d4;"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox fx:id="navLogout" alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              onMouseClicked="#handleLogout" styleClass="sidebar-hover" style="-fx-padding: 0 0 0 28;">
            <Label text="🚪" style="-fx-font-size: 18px; -fx-text-fill: #e88;"/>
            <Label text="  Logout" style="-fx-font-size: 14px; -fx-text-fill: #e88;"/>
        </HBox>

    </VBox>

    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true"
                style="-fx-background: #f4f7f9; -fx-background-color: #f4f7f9; -fx-border-color: transparent;">

        <VBox spacing="0" style="-fx-background-color: #f4f7f9;">

            <StackPane prefHeight="220" style="-fx-background-color: #1a3a4a; -fx-background-radius: 0 0 36 36;">
                <VBox alignment="BOTTOM_LEFT" style="-fx-padding: 0 40 32 40;">
                    <Label fx:id="greetingLabel" text="Hello, User 👋" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    <Label text="How are you feeling today?" style="-fx-text-fill: #b0c8d4; -fx-font-size: 15px;"/>
                    <Region prefHeight="20"/>
                    <HBox prefWidth="560" prefHeight="52" alignment="CENTER"
                          onMouseClicked="#handleStressCheck"
                          style="-fx-background-color: #24495e; -fx-background-radius: 14; -fx-cursor: hand;">
                        <Label text="Check Your Stress Level First  →" style="-fx-text-fill: #cce8f0; -fx-font-size: 15px;"/>
                    </HBox>
                </VBox>
            </StackPane>

            <HBox alignment="CENTER" style="-fx-padding: 0 40 0 40;">
                <GridPane prefHeight="80" prefWidth="560" alignment="CENTER"
                          style="-fx-background-color: linear-gradient(to right, #f5c842, #e0b434); -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(224,180,52,0.25), 12, 0, 0, 4); -fx-translate-y: -20;">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="0.1"/>
                        <ColumnConstraints percentWidth="33.2"/>
                        <ColumnConstraints percentWidth="0.1"/>
                        <ColumnConstraints percentWidth="33.3"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints valignment="CENTER"/>
                    </rowConstraints>

                    <children>
                        <VBox alignment="CENTER" spacing="2" GridPane.columnIndex="0">
                            <Label fx:id="streakLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Day Streaks" style="-fx-font-size: 12px; -fx-text-fill: #ffffffcc;"/>
                        </VBox>

                        <Region style="-fx-background-color: rgba(255,255,255,0.35); -fx-pref-height: 40; -fx-max-width: 1;" GridPane.columnIndex="1"/>

                        <VBox alignment="CENTER" spacing="2" GridPane.columnIndex="2">
                            <Label fx:id="moodLabel" text="-" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 4 0 0 0;"/>
                            <Label text="Avg. Mood" style="-fx-font-size: 12px; -fx-text-fill: #ffffffcc;"/>
                        </VBox>

                        <Region style="-fx-background-color: rgba(255,255,255,0.35); -fx-pref-height: 40; -fx-max-width: 1;" GridPane.columnIndex="3"/>

                        <VBox alignment="CENTER" spacing="2" GridPane.columnIndex="4">
                            <Label fx:id="sessionsLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Sessions" style="-fx-font-size: 12px; -fx-text-fill: #ffffffcc;"/>
                        </VBox>
                    </children>
                </GridPane>
            </HBox>

            <VBox style="-fx-padding: 8 40 32 40;" spacing="16">
                <Label text="Wellness Tool" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>

                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox fx:id="cardStressCheck" HBox.hgrow="ALWAYS" minHeight="165" prefHeight="165" maxHeight="165" spacing="8"
                          onMouseClicked="#handleStressCheck"
                          style="-fx-background-color: #c8e6f5; -fx-background-radius: 20; -fx-padding: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 3);">
                        <StackPane prefWidth="48" prefHeight="48" maxWidth="48" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                                <image><Image url="@/images/bi_card-checklist.png"/></image>
                            </ImageView>
                        </StackPane>
                        <Label text="Stress Check" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
                        <Label text="Take a questionnaire" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    </VBox>
                    <VBox fx:id="cardMyProgress" HBox.hgrow="ALWAYS" minHeight="165" prefHeight="165" maxHeight="165" spacing="8"
                          onMouseClicked="#handleMyProgress"
                          style="-fx-background-color: #d8c8f0; -fx-background-radius: 20; -fx-padding: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 3);">
                        <StackPane prefWidth="48" prefHeight="48" maxWidth="48" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                                <image><Image url="@/images/icon-park-outline_trend.png"/></image>
                            </ImageView>
                        </StackPane>
                        <Label text="My Progress" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
                        <Label text="View your trends" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    </VBox>
                </HBox>

                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox fx:id="cardRelax" HBox.hgrow="ALWAYS" minHeight="165" prefHeight="165" maxHeight="165" spacing="8"
                          onMouseClicked="#handleRelax"
                          style="-fx-background-color: #f5f0a0; -fx-background-radius: 20; -fx-padding: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 3);">
                        <StackPane prefWidth="48" prefHeight="48" maxWidth="48" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                                <image><Image url="@/images/mdi_meditation.png"/></image>
                            </ImageView>
                        </StackPane>
                        <Label text="Relax &amp; Calm" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
                        <Label text="Meditation and Sounds" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    </VBox>
                    <VBox fx:id="cardGames" HBox.hgrow="ALWAYS" minHeight="165" prefHeight="165" maxHeight="165" spacing="8"
                          onMouseClicked="#handleCalmingGames"
                          style="-fx-background-color: #90fe90; -fx-background-radius: 20; -fx-padding: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 3);">
                        <StackPane prefWidth="48" prefHeight="48" maxWidth="48" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                                <image><Image url="@/images/fluent-mdl2_game.png"/></image>
                            </ImageView>
                        </StackPane>
                        <Label text="Calming Games" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
                        <Label text="Play &amp; unwind your mind" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>