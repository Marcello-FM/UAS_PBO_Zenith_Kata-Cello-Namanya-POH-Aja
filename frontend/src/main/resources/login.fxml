<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.zenith.frontend.LoginController"
           prefWidth="1280" prefHeight="720"
           style="-fx-background-color: #1a3a4a;">

    <HBox prefWidth="1280" prefHeight="720">

        <StackPane prefWidth="580"
                   style="-fx-background-color: #142e3e;">

            <ImageView fitWidth="360" fitHeight="360"
                       preserveRatio="true" opacity="0.12">
                <image><Image url="@/images/Zenith_Logo.png"/></image>
            </ImageView>

            <VBox alignment="CENTER" spacing="16">
                <ImageView fitWidth="110" fitHeight="110" preserveRatio="true">
                    <image><Image url="@/images/Zenith_Logo.png"/></image>
                </ImageView>
                <Label text="Your mental wellness companion"
                       style="-fx-text-fill: #7dd8f0; -fx-font-size: 15px; -fx-font-style: italic;"/>
            </VBox>

        </StackPane>

        <VBox HBox.hgrow="ALWAYS"
              alignment="CENTER"
              style="-fx-padding: 60 80 60 80; -fx-background-color: #1a3a4a;">

            <VBox alignment="CENTER" spacing="6">
                <ImageView fitWidth="64" fitHeight="64" preserveRatio="true">
                    <image><Image url="@/images/Zenith_Logo.png"/></image>
                </ImageView>
            </VBox>

            <Region prefHeight="28"/>

            <Label text="Welcome Back"
                   style="-fx-text-fill: white; -fx-font-size: 34px; -fx-font-weight: bold;"/>

            <Region prefHeight="6"/>

            <Label text="Sign in to continue your journey"
                   style="-fx-text-fill: #b0c8d4; -fx-font-size: 14px;"/>

            <Region prefHeight="36"/>

            <VBox spacing="6" maxWidth="400">
                <Label text="Email"
                       style="-fx-text-fill: #b0c8d4; -fx-font-size: 13px;"/>
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 0 16 0 16; -fx-border-color: #cbd5e1; -fx-border-radius: 12;"
                      prefHeight="50" prefWidth="400">
                    <Label text="✉"
                           style="-fx-text-fill: #8aabb8; -fx-font-size: 16px;"/>
                    <TextField fx:id="emailField"
                               promptText="your.email@example.com"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1a3a4a; -fx-prompt-text-fill: #aac4cf;"/>
                </HBox>
            </VBox>

            <Region prefHeight="16"/>

            <VBox spacing="6" maxWidth="400">
                <Label text="Password"
                       style="-fx-text-fill: #b0c8d4; -fx-font-size: 13px;"/>
                <HBox fx:id="passwordBox" alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 0 16 0 16; -fx-border-color: #cbd5e1; -fx-border-radius: 12;"
                      prefHeight="50" prefWidth="400">
                    <Label text="🔒"
                           style="-fx-text-fill: #8aabb8; -fx-font-size: 15px;"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="••••••••"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1a3a4a; -fx-prompt-text-fill: #aac4cf;"/>
                    <TextField fx:id="passwordVisible"
                               promptText="••••••••"
                               visible="false" managed="false"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1a3a4a;"/>
                    <Button fx:id="eyeButton" text="👁"
                            onAction="#togglePasswordVisibility"
                            style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-font-size: 15px; -fx-padding: 0;"/>
                </HBox>
            </VBox>

            <Region prefHeight="10"/>

            <HBox prefWidth="400" alignment="CENTER_RIGHT" maxWidth="400">
                <Button text="Forgot Password?"
                        onAction="#handleForgotPassword"
                        style="-fx-background-color: transparent; -fx-text-fill: #7dd8f0; -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: transparent; -fx-padding: 0;"/>
            </HBox>

            <Region prefHeight="32"/>

            <Button fx:id="loginButton" text="Login"
                    prefWidth="400" prefHeight="52"
                    onAction="#handleLogin"
                    style="-fx-background-color: #7dd8f0; -fx-text-fill: #1a3a4a; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 28; -fx-cursor: hand; -fx-border-color: transparent;"/>

            <Region prefHeight="20"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't Have an Account?"
                       style="-fx-text-fill: #b0c8d4; -fx-font-size: 13px;"/>
                <Button text="Register"
                        onAction="#handleRegister"
                        style="-fx-background-color: transparent; -fx-text-fill: #7dd8f0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-color: transparent; -fx-padding: 0;"/>
            </HBox>
        </VBox>
    </HBox>
</StackPane>