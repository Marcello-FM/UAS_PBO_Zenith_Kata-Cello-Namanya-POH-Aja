<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.zenith.frontend.HistoryController"
      prefWidth="1280" prefHeight="720"
      style="-fx-background-color: #f4f7f9;">

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- SIDEBAR                                                                -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <VBox prefWidth="220" prefHeight="720"
          alignment="TOP_CENTER"
          style="-fx-background-color: #1a3a4a; -fx-padding: 28 0 28 0;">

        <ImageView fitWidth="64" fitHeight="64" preserveRatio="true">
            <image><Image url="@/images/Zenith_Logo.png"/></image>
            <effect><javafx.scene.effect.ColorAdjust brightness="1.0" saturation="-1.0"/></effect>
        </ImageView>

        <Region prefHeight="32"/>

        <!-- Home -->
        <HBox fx:id="navHome" alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              onMouseClicked="#handleHome"
              style="-fx-background-color: transparent; -fx-padding: 0 0 0 28; -fx-cursor: hand;">
            <Label text="⌂" style="-fx-font-size: 20px; -fx-text-fill: #b0c8d4;"/>
            <Label text="  Home" style="-fx-font-size: 14px; -fx-text-fill: #b0c8d4;"/>
        </HBox>

        <Region prefHeight="4"/>

        <!-- Relax -->
        <HBox fx:id="navRelax" alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              onMouseClicked="#handleRelax"
              style="-fx-background-color: transparent; -fx-padding: 0 0 0 28; -fx-cursor: hand;">
            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                <image><Image url="@/images/mdi_meditation.png"/></image>
                <effect><javafx.scene.effect.ColorAdjust brightness="1.0" saturation="-1.0"/></effect>
            </ImageView>
            <Label text="  Relax" style="-fx-font-size: 14px; -fx-text-fill: #b0c8d4;"/>
        </HBox>

        <Region prefHeight="4"/>

        <!-- Games -->
        <HBox fx:id="navGames" alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              onMouseClicked="#handleGames"
              style="-fx-background-color: transparent; -fx-padding: 0 0 0 28; -fx-cursor: hand;">
            <Label text="🎮" style="-fx-font-size: 18px; -fx-text-fill: #b0c8d4;"/>
            <Label text="  Games" style="-fx-font-size: 14px; -fx-text-fill: #b0c8d4;"/>
        </HBox>

        <Region prefHeight="4"/>

        <!-- Statistics (active — history is under statistics) -->
        <HBox alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              style="-fx-background-color: #7dd8f0; -fx-padding: 0 0 0 28; -fx-cursor: hand;">
            <Label text="�" style="-fx-font-size: 18px; -fx-text-fill: #1a3a4a;"/>
            <Label text="  Statistics" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a3a4a;"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Logout -->
        <HBox fx:id="backButton" alignment="CENTER_LEFT" prefWidth="220" prefHeight="48"
              onMouseClicked="#handleBack"
              style="-fx-background-color: transparent; -fx-padding: 0 0 0 28; -fx-cursor: hand;">
            <Label text="🚪" style="-fx-font-size: 18px; -fx-text-fill: #e88;"/>
            <Label text="  Logout" style="-fx-font-size: 14px; -fx-text-fill: #e88;"/>
        </HBox>

    </VBox>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- MAIN CONTENT                                                           -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true"
                style="-fx-background: #f4f7f9; -fx-background-color: #f4f7f9;
                       -fx-border-color: transparent;">

        <VBox spacing="0" style="-fx-background-color: #f4f7f9;">

            <!-- ── HERO HEADER ─────────────────────────────────────────────── -->
            <StackPane prefHeight="140"
                       style="-fx-background-color: #1a3a4a;
                              -fx-background-radius: 0 0 36 36;">
                <VBox alignment="BOTTOM_LEFT"
                      style="-fx-padding: 0 40 28 40;">
                    <Label text="My Progress"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 30px;
                                  -fx-font-weight: bold;"/>
                    <Label text="Track your wellness journey"
                           style="-fx-text-fill: #b0c8d4;
                                  -fx-font-size: 14px;"/>
                </VBox>
            </StackPane>

            <!-- ── STATS CARDS ─────────────────────────────────────────────── -->
            <HBox style="-fx-padding: 0 40 0 40;">
                <HBox prefHeight="80" alignment="CENTER"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #f5c842;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.12),12,0,0,4);
                             -fx-translate-y: -20;">

                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="2">
                        <Label fx:id="streakLabel" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Day Streaks"
                               style="-fx-font-size: 12px; -fx-text-fill: #ffffffcc;"/>
                    </VBox>

                    <Separator orientation="VERTICAL" prefHeight="44"
                               style="-fx-background-color: #ffffff66;"/>

                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="2">
                        <Label fx:id="moodLabel" text="-"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Avg. Mood"
                               style="-fx-font-size: 12px; -fx-text-fill: #ffffffcc;"/>
                    </VBox>

                    <Separator orientation="VERTICAL" prefHeight="44"
                               style="-fx-background-color: #ffffff66;"/>

                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="2">
                        <Label fx:id="sessionsLabel" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Sessions"
                               style="-fx-font-size: 12px; -fx-text-fill: #ffffffcc;"/>
                    </VBox>

                    <Separator orientation="VERTICAL" prefHeight="44"
                               style="-fx-background-color: #ffffff66;"/>

                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="2">
                        <Label fx:id="averageScoreLabel" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Avg. Score"
                               style="-fx-font-size: 12px; -fx-text-fill: #ffffffcc;"/>
                    </VBox>

                </HBox>
            </HBox>

            <!-- ── ASSESSMENT HISTORY ──────────────────────────────────────── -->
            <VBox style="-fx-padding: 4 40 24 40;" spacing="14">

                <Label text="Assessment History"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1a3a4a;"/>

                <!-- History rows populated by controller -->
                <VBox fx:id="historyList" spacing="10"/>

            </VBox>

            <!-- ── WEEKLY INSIGHT ──────────────────────────────────────────── -->
            <VBox style="-fx-padding: 0 40 32 40;">
                <HBox spacing="16" alignment="CENTER_LEFT"
                      style="-fx-background-color: #1a3a4a;
                             -fx-background-radius: 18;
                             -fx-padding: 20 24 20 24;">
                    <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                        <image><Image url="@/images/icon-park-outline_trend.png"/></image>
                        <effect><javafx.scene.effect.ColorAdjust brightness="1.0" saturation="-1.0"/></effect>
                    </ImageView>
                    <VBox spacing="4">
                        <Label text="Weekly Insight"
                               style="-fx-text-fill: #7dd8f0;
                                      -fx-font-size: 15px;
                                      -fx-font-weight: bold;"/>
                        <Label text="Keep up the great work! Regular check-ins help you understand your stress patterns and improve your wellbeing over time."
                               wrapText="true"
                               style="-fx-text-fill: #b0c8d4;
                                      -fx-font-size: 13px;"
                               maxWidth="700"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>

</HBox>
