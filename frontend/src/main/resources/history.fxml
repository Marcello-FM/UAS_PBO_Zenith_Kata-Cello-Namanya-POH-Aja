<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@styles/dashboard.css" styleClass="root-pane" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.zenith.frontend.HistoryController">
    <children>
        <VBox alignment="CENTER" layoutX="390.0" layoutY="110.0" prefHeight="500.0" prefWidth="500.0" spacing="25.0" styleClass="center-box">
            <children>
                <Label text="Progress &amp; Riwayat" textFill="#7dd8f0">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </Label>
                <Label text="Grafik dan riwayat perjalanan kesehatan mentalmu." textFill="WHITE" wrapText="true" textAlignment="CENTER" />
                <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="50.0" prefWidth="350.0" styleClass="menu-button" text="Kembali ke Dashboard">
                    <VBox.margin>
                        <Insets top="40.0" />
                    </VBox.margin>
                </Button>
            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>