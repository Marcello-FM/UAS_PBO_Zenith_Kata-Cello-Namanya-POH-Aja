<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.zenith.frontend.ForgotPasswordController"
           prefWidth="1280" prefHeight="720"
           style="-fx-background-color: #1a3a4a;"> <HBox prefWidth="1280" prefHeight="720">

    <StackPane prefWidth="580"
               style="-fx-background-color: #142e3e;"> <VBox alignment="CENTER" spacing="16"> <ImageView fitWidth="120" fitHeight="120" preserveRatio="true">
        <image><Image url="@/images/Zenith_Logo.png"/></image>
    </ImageView>

        <Label text="ZENITH"
               style="-fx-text-fill: white;
                              -fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

        <Label text="Your mental wellness companion"
               style="-fx-text-fill: #7dd8f0;
                              -fx-font-size: 14px;"/> </VBox>
    </StackPane>

    <VBox HBox.hgrow="ALWAYS"
          alignment="CENTER"
          style="-fx-padding: 60 80 60 80; -fx-background-color: #1a3a4a;"
          spacing="0">

        <HBox maxWidth="400" alignment="CENTER_LEFT">
            <Button fx:id="backButton" text="‹ Back" onAction="#handleBack"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: #b0c8d4;
                               -fx-font-size: 18px;
                               -fx-cursor: hand;
                               -fx-padding: 0 0 0 -5;"/>
        </HBox>

        <Region prefHeight="24"/> <Label text="Create New Password"
                                         style="-fx-text-fill: white;
                          -fx-font-size: 34px;
                          -fx-font-weight: bold;"/>

        <Region prefHeight="6"/>

        <Label fx:id="emailLabel" text="Create your new password"
               style="-fx-text-fill: #7dd8f0;
                          -fx-font-size: 13px;"
               wrapText="true"
               maxWidth="400"/>

        <Region prefHeight="24"/>

        <VBox spacing="6" maxWidth="400">
            <Label text="New Password"
                   style="-fx-text-fill: #b0c8d4; -fx-font-size: 13px;"/>
            <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="48" prefWidth="400"
                  style="-fx-background-color: white;
                             -fx-background-radius: 15;
                             -fx-padding: 0 14 0 14;">
                <effect><DropShadow radius="5.0" offsetX="2.0" offsetY="2.0" color="#00000033"/></effect>
                <Label text="✉️" style="-fx-text-fill: #8aabb8; -fx-font-size: 15px;"/> <PasswordField fx:id="newPasswordField" promptText="your.email@example.com" HBox.hgrow="ALWAYS"
                                                                                                       style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1a3a4a; -fx-prompt-text-fill: #aac4cf;"/>
                <TextField fx:id="newPasswordVisible" visible="false" managed="false" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1a3a4a;"/>
                <Button fx:id="eyeBtn1" text="👁" onAction="#toggleNewPassword"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 15px; -fx-padding: 0;"/>
            </HBox>
        </VBox>

        <Region prefHeight="16"/>

        <VBox spacing="6" maxWidth="400">
            <Label text="Confirm Password"
                   style="-fx-text-fill: #b0c8d4; -fx-font-size: 13px;"/>
            <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="48" prefWidth="400"
                  style="-fx-background-color: white;
                             -fx-background-radius: 15;
                             -fx-padding: 0 14 0 14;">
                <effect><DropShadow radius="5.0" offsetX="2.0" offsetY="2.0" color="#00000033"/></effect>
                <Label text="🔒" style="-fx-text-fill: #8aabb8; -fx-font-size: 15px;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="••••••••" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1a3a4a; -fx-prompt-text-fill: #aac4cf;"/>
                <TextField fx:id="confirmPasswordVisible" visible="false" managed="false" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1a3a4a;"/>
                <Button fx:id="eyeBtn2" text="👁" onAction="#toggleConfirmPassword"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 15px; -fx-padding: 0;"/>
            </HBox>
        </VBox>

        <Region prefHeight="36"/>

        <Button fx:id="createButton" text="Create Password" prefWidth="400" prefHeight="52" onAction="#handleCreatePassword"
                style="-fx-background-color: #87CEFA;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 28;
                           -fx-cursor: hand;
                           -fx-border-color: transparent;"/>
    </VBox>
</HBox>
</StackPane>