<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.zenith.frontend.ForgotPasswordController"
           prefWidth="1280" prefHeight="720"
           style="-fx-background-color: #1a3a4a;">

    <HBox prefWidth="1280" prefHeight="720">

        <StackPane prefWidth="580"
                   style="-fx-background-color: #142e3e;">

            <ImageView fitWidth="360" fitHeight="360"
                       preserveRatio="true" opacity="0.12">
                <image><Image url="@/images/Zenith_Logo.png"/></image>
            </ImageView>

            <VBox alignment="CENTER" spacing="16">
                <ImageView fitWidth="110" fitHeight="110" preserveRatio="true">
                    <image><Image url="@/images/Zenith_Logo.png"/></image>
                </ImageView>
                <Label text="Reset your password securely"
                       style="-fx-text-fill: #7dd8f0;
                              -fx-font-size: 15px;
                              -fx-font-style: italic;"/>
            </VBox>

        </StackPane>

        <VBox HBox.hgrow="ALWAYS"
              alignment="CENTER"
              style="-fx-padding: 60 80 60 80; -fx-background-color: #1a3a4a;"
              spacing="0">

            <HBox prefWidth="400" maxWidth="400" alignment="CENTER_LEFT">
                <Button fx:id="backButton" text="<  Back"
                        onAction="#handleBack"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #b0c8d4;
                               -fx-font-size: 18px;
                               -fx-cursor: hand;
                               -fx-border-color: transparent;
                               -fx-padding: 4 0 4 12;"/>
            </HBox>

            <Region prefHeight="24"/>

            <ImageView fitWidth="64" fitHeight="64" preserveRatio="true">
                <image><Image url="@/images/Zenith_Logo.png"/></image>
            </ImageView>

            <Region prefHeight="20"/>

            <Label text="Create New Password"
                   style="-fx-text-fill: white;
                          -fx-font-size: 34px;
                          -fx-font-weight: bold;"/>

            <Region prefHeight="6"/>

            <Label fx:id="emailLabel" text="Reset password untuk akun Anda"
                   style="-fx-text-fill: #7dd8f0;
                          -fx-font-size: 13px;"
                   wrapText="true"
                   maxWidth="400"/>

            <Region prefHeight="24"/>

            <VBox spacing="6" maxWidth="400">
                <Label text="New Password"
                       style="-fx-text-fill: #b0c8d4; -fx-font-size: 13px;"/>
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: white;
                             -fx-background-radius: 10;
                             -fx-padding: 0 14 0 14;"
                      prefHeight="48" prefWidth="400">
                    <Label text="🔒"
                           style="-fx-text-fill: #8aabb8; -fx-font-size: 15px;"/>
                    <PasswordField fx:id="newPasswordField"
                                   promptText="••••••••"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: transparent;
                                          -fx-border-color: transparent;
                                          -fx-font-size: 14px;
                                          -fx-text-fill: #1a3a4a;
                                          -fx-prompt-text-fill: #aac4cf;"/>
                    <TextField fx:id="newPasswordVisible"
                               visible="false" managed="false"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-font-size: 14px;
                                      -fx-text-fill: #1a3a4a;"/>
                    <Button fx:id="eyeBtn1" text="👁"
                            onAction="#toggleNewPassword"
                            style="-fx-background-color: transparent;
                                   -fx-border-color: transparent;
                                   -fx-cursor: hand;
                                   -fx-font-size: 15px;
                                   -fx-padding: 0;"/>
                </HBox>
            </VBox>

            <Region prefHeight="16"/>

            <VBox spacing="6" maxWidth="400">
                <Label text="Confirm Password"
                       style="-fx-text-fill: #b0c8d4; -fx-font-size: 13px;"/>
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: white;
                             -fx-background-radius: 10;
                             -fx-padding: 0 14 0 14;"
                      prefHeight="48" prefWidth="400">
                    <Label text="🔒"
                           style="-fx-text-fill: #8aabb8; -fx-font-size: 15px;"/>
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="••••••••"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: transparent;
                                          -fx-border-color: transparent;
                                          -fx-font-size: 14px;
                                          -fx-text-fill: #1a3a4a;
                                          -fx-prompt-text-fill: #aac4cf;"/>
                    <TextField fx:id="confirmPasswordVisible"
                               visible="false" managed="false"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-font-size: 14px;
                                      -fx-text-fill: #1a3a4a;"/>
                    <Button fx:id="eyeBtn2" text="👁"
                            onAction="#toggleConfirmPassword"
                            style="-fx-background-color: transparent;
                                   -fx-border-color: transparent;
                                   -fx-cursor: hand;
                                   -fx-font-size: 15px;
                                   -fx-padding: 0;"/>
                </HBox>
            </VBox>

            <Region prefHeight="36"/>

            <Button fx:id="createButton" text="Create Password"
                    prefWidth="400" prefHeight="52"
                    onAction="#handleCreatePassword"
                    style="-fx-background-color: #7dd8f0;
                           -fx-text-fill: #1a3a4a;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 28;
                           -fx-cursor: hand;
                           -fx-border-color: transparent;"/>

        </VBox>
    </HBox>
</StackPane>
